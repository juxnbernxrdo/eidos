{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/contracts/core/invariant.schema.json",
  "title": "InvariantContract",
  "description": "Formal contract schema for machine-checkable architectural rules and invariant definitions.",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "CORE-CONTRACT-009" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "invariant_id": { "type": "string", "pattern": "^(INV|ARCH)-[0-9]+$" },
    "name": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "category": {
      "type": "string",
      "enum": ["ARCHITECTURE", "SECURITY", "ISOLATION", "EPISTEMICS", "VERIFICATION", "GOVERNANCE"]
    },
    "enforcement_level": {
      "type": "string",
      "enum": ["ADVISORY", "BLOCKING"]
    },
    "scope_directory": { "type": "string" },
    "forbidden_imports": {
      "type": "array",
      "items": { "type": "string" }
    },
    "required_interfaces": {
      "type": "array",
      "items": { "type": "string" }
    },
    "evidence_requirement": { "type": "string" },
    "status": {
      "type": "string",
      "enum": ["ARCHITECTED", "CONTRACT_BOUND", "CALIBRATED"]
    }
  },
  "required": [
    "contract_id",
    "contract_version",
    "invariant_id",
    "name",
    "description",
    "category",
    "enforcement_level",
    "scope_directory",
    "status"
  ],
  "additionalProperties": false
}
