{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/contracts/core/capability-permission.schema.json",
  "title": "CapabilityPermissionContract",
  "description": "Formal contract schema for least-privilege capability grants and sandbox permissions.",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "CORE-CONTRACT-008" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "grant_id": { "type": "string", "pattern": "^GRANT-[A-Za-z0-9_-]+$" },
    "subject": {
      "type": "object",
      "properties": {
        "type": { "type": "string", "enum": ["AGENT", "SKILL", "TOOL"] },
        "id": { "type": "string" }
      },
      "required": ["type", "id"],
      "additionalProperties": false
    },
    "filesystem": {
      "type": "object",
      "properties": {
        "scope": {
          "type": "string",
          "enum": ["READ_ONLY", "WORKTREE_ONLY", "REPO_BOUNDED"]
        },
        "allowed_read_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "allowed_write_patterns": {
          "type": "array",
          "items": { "type": "string" }
        },
        "denied_patterns": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["scope", "allowed_read_patterns", "allowed_write_patterns", "denied_patterns"],
      "additionalProperties": false
    },
    "network": {
      "type": "object",
      "properties": {
        "egress": {
          "type": "string",
          "enum": ["DISABLED", "LOOPBACK_ONLY", "HOST_WHITELIST"]
        },
        "allowed_hosts": {
          "type": "array",
          "items": { "type": "string" }
        }
      },
      "required": ["egress", "allowed_hosts"],
      "additionalProperties": false
    },
    "execution": {
      "type": "object",
      "properties": {
        "allow_subprocess": { "type": "boolean" },
        "allowed_binaries": {
          "type": "array",
          "items": { "type": "string" }
        },
        "timeout_seconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
      },
      "required": ["allow_subprocess", "allowed_binaries", "timeout_seconds"],
      "additionalProperties": false
    },
    "secret_access": {
      "type": "boolean",
      "const": false,
      "description": "Secrets access is strictly forbidden in contracts."
    },
    "issued_at": { "type": "string", "format": "date-time" }
  },
  "required": [
    "contract_id",
    "contract_version",
    "grant_id",
    "subject",
    "filesystem",
    "network",
    "execution",
    "secret_access",
    "issued_at"
  ],
  "additionalProperties": false
}
