{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/contracts/core/task.schema.json",
  "title": "TaskContract",
  "description": "Formal contract schema for contract-bounded task dispatch to subagents or harnesses.",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "CORE-CONTRACT-002" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "task_id": { "type": "string", "pattern": "^TASK-[0-9]+$" },
    "spec_id": { "type": "string", "pattern": "^SPEC-[0-9]+$" },
    "subspec_id": { "type": "string" },
    "title": { "type": "string", "minLength": 1 },
    "objective": { "type": "string", "minLength": 1 },
    "status": {
      "type": "string",
      "enum": ["PENDING", "IN_PROGRESS", "VERIFIED", "CONVERGED", "FAILED", "ESCALATED"]
    },
    "target_files": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "allowed_tools": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "acceptance_criteria": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "assigned_agent_id": { "type": "string" },
    "max_turns": { "type": "integer", "minimum": 1, "maximum": 50, "default": 30 },
    "convergence_attempts": { "type": "integer", "minimum": 0, "default": 0 }
  },
  "required": [
    "contract_id",
    "contract_version",
    "task_id",
    "spec_id",
    "title",
    "objective",
    "status",
    "target_files",
    "allowed_tools",
    "acceptance_criteria"
  ],
  "additionalProperties": false
}
