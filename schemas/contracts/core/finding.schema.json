{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/contracts/core/finding.schema.json",
  "title": "FindingContract",
  "description": "Formal contract schema for static analysis, linter, or architectural findings.",
  "type": "object",
  "properties": {
    "contract_id": { "type": "string", "const": "CORE-CONTRACT-006" },
    "contract_version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "finding_id": { "type": "string", "pattern": "^FIND-[A-Za-z0-9_-]+$" },
    "severity": {
      "type": "string",
      "enum": ["CRITICAL", "HIGH", "MEDIUM", "LOW", "INFO"]
    },
    "category": {
      "type": "string",
      "enum": ["SECURITY", "ARCHITECTURE", "PERFORMANCE", "DEAD_CODE", "DRIFT", "BUG", "INVARIANT"]
    },
    "title": { "type": "string", "minLength": 1 },
    "description": { "type": "string", "minLength": 1 },
    "file_path": { "type": "string" },
    "line_range": {
      "type": "array",
      "items": { "type": "integer" },
      "minItems": 2,
      "maxItems": 2
    },
    "evidence_ref": { "type": "string" },
    "remediation": { "type": "string" }
  },
  "required": [
    "contract_id",
    "contract_version",
    "finding_id",
    "severity",
    "category",
    "title",
    "description",
    "file_path"
  ],
  "additionalProperties": false
}
