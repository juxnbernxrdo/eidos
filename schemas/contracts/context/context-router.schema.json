{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/contracts/context/context-router.schema.json",
  "title": "ContextRouterContract",
  "description": "Formal contract schema for Eidos Context Router, governing Minimal Sufficient Context (MSC) assembly, auditable selection, and token budgeting.",
  "type": "object",
  "properties": {
    "contract_id": {
      "type": "string",
      "const": "CTX-CONTRACT-001"
    },
    "contract_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "routing_request": {
      "type": "object",
      "properties": {
        "request_id": { "type": "string" },
        "task": {
          "type": "object",
          "properties": {
            "task_id": { "type": "string" },
            "objective": { "type": "string" },
            "target_files": {
              "type": "array",
              "items": { "type": "string" }
            },
            "seed_symbols": {
              "type": "array",
              "items": { "type": "string" }
            }
          },
          "required": ["task_id", "objective", "target_files"],
          "additionalProperties": false
        },
        "context_sources": {
          "type": "object",
          "properties": {
            "include_graph": { "type": "boolean", "default": true },
            "include_rules": { "type": "boolean", "default": true },
            "include_specs": { "type": "boolean", "default": true },
            "include_skills": { "type": "boolean", "default": false },
            "include_memory": { "type": "boolean", "default": false },
            "include_evidence": { "type": "boolean", "default": true }
          },
          "required": ["include_graph", "include_rules", "include_specs", "include_evidence"],
          "additionalProperties": false
        },
        "budget_constraints": {
          "type": "object",
          "properties": {
            "max_tokens": { "type": "integer", "minimum": 500, "maximum": 200000 },
            "reserve_for_generation": { "type": "integer", "minimum": 200, "maximum": 50000 },
            "k_hop_limit": { "type": "integer", "minimum": 0, "maximum": 3, "default": 2 }
          },
          "required": ["max_tokens", "reserve_for_generation"],
          "additionalProperties": false
        },
        "security_constraints": {
          "type": "object",
          "properties": {
            "quarantine_adversarial": { "type": "boolean", "default": true },
            "allow_inferred_edges": { "type": "boolean", "default": false },
            "isolated_project_id": { "type": "string" }
          },
          "required": ["quarantine_adversarial", "isolated_project_id"],
          "additionalProperties": false
        }
      },
      "required": ["request_id", "task", "context_sources", "budget_constraints", "security_constraints"],
      "additionalProperties": false
    },
    "routing_response": {
      "type": "object",
      "properties": {
        "msc_id": { "type": "string" },
        "request_id": { "type": "string" },
        "total_tokens": { "type": "integer", "minimum": 0 },
        "budget_exhausted": { "type": "boolean" },
        "escalation_required": { "type": "boolean" },
        "pinned_boundary_contracts": {
          "type": "array",
          "items": { "type": "string" }
        },
        "assembled_items": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": { "type": "string" },
              "order_index": { "type": "integer" },
              "source_domain": {
                "type": "string",
                "enum": ["GRAPH_NODE", "RULE", "SPEC", "SKILL", "MEMORY", "EVIDENCE", "FILE_AST"]
              },
              "content_format": {
                "type": "string",
                "enum": ["FULL_CODE", "SIGNATURE_ONLY", "CONTRACT_COMMENT", "METADATA", "DECLARATION"]
              },
              "content": { "type": "string" },
              "token_count": { "type": "integer", "minimum": 0 },
              "epistemic_provenance": {
                "type": "string",
                "enum": ["EXTRACTED", "INFERRED", "USER_CONFIRMED", "AGENT_PROPOSED"]
              },
              "confidence": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
              "selection_audit": {
                "type": "object",
                "properties": {
                  "selection_reason": { "type": "string" },
                  "proximity_hops": { "type": "integer", "minimum": 0 },
                  "matched_query": { "type": "string" }
                },
                "required": ["selection_reason"],
                "additionalProperties": false
              }
            },
            "required": [
              "item_id",
              "order_index",
              "source_domain",
              "content_format",
              "content",
              "token_count",
              "epistemic_provenance",
              "confidence",
              "selection_audit"
            ],
            "additionalProperties": false
          }
        },
        "quarantined_exclusions": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "item_id": { "type": "string" },
              "exclusion_reason": {
                "type": "string",
                "enum": [
                  "EXCEEDED_TOKEN_BUDGET",
                  "POISONED_FILE_FLAG",
                  "UNCONFIRMED_INFERENCE",
                  "CROSS_PROJECT_ISOLATION",
                  "UNAUTHORIZED_MEMORY",
                  "REDUNDANT_AST"
                ]
              },
              "details": { "type": "string" }
            },
            "required": ["item_id", "exclusion_reason"],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "msc_id",
        "request_id",
        "total_tokens",
        "budget_exhausted",
        "escalation_required",
        "assembled_items",
        "quarantined_exclusions"
      ],
      "additionalProperties": false
    }
  },
  "required": ["contract_id", "contract_version", "routing_request", "routing_response"],
  "additionalProperties": false
}
