{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://eidos.dev/schemas/specs/scenario.schema.json",
  "title": "EidosScenario",
  "description": "Formal schema for behavioral Given/When/Then acceptance scenarios.",
  "type": "object",
  "properties": {
    "scenario_id": {
      "type": "string",
      "pattern": "^SCENARIO-[0-9]{3}-[0-9]{2}$"
    },
    "spec_id": {
      "type": "string",
      "pattern": "^SPEC-[0-9]{3}(-[A-Z0-9_-]+)?$"
    },
    "title": { "type": "string", "minLength": 1 },
    "given": { "type": "string", "minLength": 1 },
    "when": { "type": "string", "minLength": 1 },
    "then": { "type": "string", "minLength": 1 },
    "expected_verdict": {
      "type": "string",
      "enum": ["PASS", "FAIL", "REJECT", "ESCALATE"]
    }
  },
  "required": [
    "scenario_id",
    "spec_id",
    "title",
    "given",
    "when",
    "then",
    "expected_verdict"
  ],
  "additionalProperties": false
}
